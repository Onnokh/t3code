# devski-code — pinned interactive OpenCode 2 sidecar.
#
# Second container of the `devski-code` service (see README.md and the
# Digital Home deployment topology): the T3 environment reaches this server
# privately at http://devski-opencode:4096 through the fork's bounded
# `opencode2` provider. It is never published on a public domain.
#
# Version contract: the numeric prerelease below MUST equal the
# `@opencode-ai/client` pin in `apps/server/package.json`
# (OPENCODE2_PINNED_VERSION in `apps/server/src/provider/opencode2Runtime.ts`).
# The provider refuses to run against any other server build, so bump the
# CLI and client together in one reviewed change.
#
# Build from the repository root:
#
#   docker build -f infra/devski-code/Dockerfile.opencode -t devski-opencode .
FROM oven/bun:1

ENV TZ=Europe/Amsterdam \
    BUN_INSTALL=/opt/bun-global \
    PATH="/opt/bun-global/bin:$PATH"

# git: OpenCode reads repository state inside the Code Workspace Root.
# curl: fetching the source-control CLIs below.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl ripgrep \
 && rm -rf /var/lib/apt/lists/*

# Source-control CLIs, matching the Digital Home Harness tool-belt and the T3
# environment image. Interactive OpenCode sessions clone and review through
# them inside the shared Code Workspace Root. `glab` publishes no apt
# repository, so its release .deb is pinned at the Harness version.
ARG GLAB_VERSION=1.108.0
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh \
 && curl -fsSL -o /tmp/glab.deb "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_$(dpkg --print-architecture).deb" \
 && apt-get install -y /tmp/glab.deb && rm /tmp/glab.deb \
 && rm -rf /var/lib/apt/lists/* \
 && gh --version && glab --version

# `glab` posts telemetry and checks for a newer release on every invocation.
# As a git credential helper it runs on every fetch and push, so both become a
# network round-trip in the critical path. This MUST be environment rather than
# `glab config set --global`: that writes under XDG_CONFIG_HOME, which below is
# a volume, and a volume mount masks whatever the image put there.
ENV GLAB_SEND_TELEMETRY=0 \
    GLAB_CHECK_UPDATE=0

# Make a plain `git clone` of a private repository work with no token in the
# URL and no interactive login. Each helper resolves the credential from
# GH_TOKEN / GITLAB_TOKEN at call time, so the image holds no secret. Self-hosted
# GitLab needs its own key, so GITLAB_HOST is honoured when it is not gitlab.com.
ARG GITLAB_HOST=gitlab.com
RUN git config --system credential."https://github.com".helper '!gh auth git-credential' \
 && git config --system credential."https://gitlab.com".helper '!glab auth git-credential' \
 && if [ "${GITLAB_HOST}" != "gitlab.com" ]; then \
      git config --system credential."https://${GITLAB_HOST}".helper '!glab auth git-credential'; \
    fi

# Pinned numeric prerelease — never the floating `next` tag. The trusted
# postinstall selects the platform binary.
RUN bun install -g --trust @opencode-ai/cli@0.0.0-next-17199

# The public skill library, installed with the `skills` CLI — the same command
# the library's README gives and the Digital Home Harness image runs, so a Code
# session and an Agent Job know the same skills instead of each image inventing
# its own copy of the library layout.
#
# HOME picks the target: the CLI writes $HOME/.agents/skills. It stays in /opt
# because /data/opencode below is a volume, and a mount masks whatever the image
# put there. `skills add` takes no git ref, so the library resolves to its
# default branch at build time and .agents/.skill-lock.json records what landed.
ARG SKILLS_CLI_VERSION=1.5.22
RUN HOME=/opt/agent-skills bunx --bun skills@${SKILLS_CLI_VERSION} \
      add Onnokh/skills --agent opencode --skill '*' --copy --global --yes \
 && test -d /opt/agent-skills/.agents/skills

# Interactive OpenCode state (sessions, auth, config) lives on its own
# volume, owned by this container only.
ENV XDG_DATA_HOME=/data/opencode/share \
    XDG_CONFIG_HOME=/data/opencode/config \
    XDG_STATE_HOME=/data/opencode/state \
    XDG_CACHE_HOME=/var/cache/xdg

# Operator-owned OpenCode configuration, declared in this repository instead
# of edited inside the running container. It is the one place this container
# says what a Code session can reach: the installed skill library above, and
# the Executor MCP that fronts every external integration. The bearer comes
# from EXECUTOR_MCP_TOKEN at run time, so the image holds no secret; without it
# the `executor` server reports failed instead of quietly not existing.
#
# It also disables the `gitlab` provider:
# OpenCode finds that provider from the container environment, but this
# deployment holds no GitLab Duo entitlement, so its models cannot serve a
# Run. They still filled 23 of the 62 Agent Job model choices and pushed the
# usable models out of sight in the Job editor.
#
# The file MUST stay outside /data/opencode. That path is a volume, and a
# volume mount masks anything the image puts below it, so a configuration
# baked into XDG_CONFIG_HOME would never be read at run time. OPENCODE_CONFIG
# names this copy explicitly.
COPY infra/devski-code/opencode.json /etc/devski/opencode.json
ENV OPENCODE_CONFIG=/etc/devski/opencode.json

# /data/opencode: interactive OpenCode 2 state (owner: this container).
# /workspaces/code: the Code Workspace Root, shared with the T3 environment
# at the identical absolute path.
VOLUME /data/opencode
VOLUME /workspaces/code

WORKDIR /workspaces/code

EXPOSE 4096

# The server takes its Basic-auth password from OPENCODE_SERVER_PASSWORD
# (Coolify secret). The same value goes into T3's opencode2 provider
# settings as `serverPassword`.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["bun", "-e", "fetch('http://127.0.0.1:4096/api/health',{headers:{authorization:'Basic '+Buffer.from('opencode:'+process.env.OPENCODE_SERVER_PASSWORD).toString('base64')}}).then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))"]

CMD ["opencode2", "serve", "--hostname", "0.0.0.0", "--port", "4096"]
